; A wrong evaluator branch, binding order or truth rule must fail an assertion.
(assert (= (+ 1 2 3) 6))
(assert (= (*) 1))
(assert (= (- 9 2 3) 4))
(assert (= (/ 24 2 3) 4))
(assert (= (remainder -7 3) -1))
(assert (< 1 2 3))
(assert (not (< 1 3 2)))
(assert (if 0 #t #f))
(assert (equal? '(a (b c) . d) (cons 'a (cons '(b c) 'd))))
(assert (= (let ((x 5)) (let ((x 7) (y x)) (+ x y))) 12))
(assert (= (cond ((> 1 3) 9) ((= 2 2) 17) (else 0)) 17))
(assert (= (begin 1 2 3) 3))
(assert (and #t 1 2))
(assert (= (or #f 7 (/ 1 0)) 7))
(assert (not (and #f (/ 1 0))))
(assert (null? '()))
(assert (pair? '(a)))
(assert (symbol? 'hello))
(assert (number? -42))
(assert (boolean? #f))
(assert (string? "hello"))
(assert (procedure? +))
(assert (equal? ((lambda args args) 1 2 3) '(1 2 3)))
(assert (equal? ((lambda (x . rest) rest) 1 2 3) '(2 3)))
(assert (= (apply + 1 2 '(3 4)) 10))
(display "ok") (newline)
