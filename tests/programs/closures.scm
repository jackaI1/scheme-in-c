; Captured environments must survive return and collection; set! shares a binding.
(define (counter start)
  (lambda () (set! start (+ start 1)) start))
(define a (counter 0))
(define b (counter 10))
(assert (= (a) 1))
(gc)
(assert (= (a) 2))
(assert (= (b) 11))
(define (compose f g) (lambda (x) (f (g x))))
(define add2 (let ((n 2)) (lambda (x) (+ x n))))
(assert (= ((compose add2 add2) 5) 9))
(define x 99)
(define (read-x) x)
(assert (= (let ((x 3)) (read-x)) 99))
(define (even? n) (if (= n 0) #t (odd? (- n 1))))
(define (odd? n) (if (= n 0) #f (even? (- n 1))))
(assert (even? 100000))
(display "ok") (newline)
